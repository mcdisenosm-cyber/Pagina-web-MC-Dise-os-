# Copia este archivo como .env.local y completa los valores reales.
# No subas .env.local al repositorio (está excluido en .gitignore).
#
# REGLA DE SEGURIDAD:
# - Las variables con prefijo NEXT_PUBLIC_ son PÚBLICAS: cualquiera puede verlas en el
#   navegador. Úsalas solo para datos que ya son públicos (número de WhatsApp, URL).
# - Las claves y contraseñas NUNCA llevan NEXT_PUBLIC_. Se leen solo en el servidor con
#   getServerSecret() de src/server/env.ts.
# - En producción, define estas variables en el panel del hosting, no en archivos.

# ---- Públicas ----

# Número de WhatsApp de MC Diseños en formato internacional, SOLO dígitos:
# código de país + número, sin "+", espacios ni guiones.
# Formato ilustrativo (no es un número real): 573001234567
# Si se deja vacío, los botones de WhatsApp se desactivan y se muestran instrucciones.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL pública del sitio (para metadatos, sitemap y robots). Ejemplo: https://www.dominio.com
NEXT_PUBLIC_SITE_URL=

# ---- Panel de administración (Keystatic, /keystatic) ----
# Las genera automáticamente el asistente de Keystatic al crear la GitHub App
# (ver README, sección "Panel de administración"). Sin ellas, el panel queda
# desactivado en producción; la web pública funciona igual.
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=      # secreta
# KEYSTATIC_SECRET=                    # secreta
# NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
# Solo para la configuración inicial en local: forzar el modo GitHub con `npm run dev`.
# NEXT_PUBLIC_KEYSTATIC_STORAGE=github

# ---- Secretas (solo servidor) — aún no se usan, se dejan como referencia ----

# Base de datos, si en el futuro se guardan solicitudes.
# DATABASE_URL=

# Clave de la API del chatbot (por ejemplo, Anthropic).
# ANTHROPIC_API_KEY=

# Clave secreta del captcha (por ejemplo, Cloudflare Turnstile) para frenar spam y abuso.
# TURNSTILE_SECRET_KEY=
